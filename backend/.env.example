# ── Base de données ───────────────────────────────────────────────────────────
# Dev SQLite
DATABASE_URL="file:./dev.db"
# Prod PostgreSQL (recommandé)
# DATABASE_URL="postgresql://user:password@host:5432/rizivoirien"

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGEZ_MOI_EN_PRODUCTION"

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
UPLOAD_DIR="uploads"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origines autorisées en production, séparées par des virgules.
# Localhost est toujours autorisé en dev — cette variable n'est utilisée qu'en prod.
ALLOWED_ORIGINS=https://rizivoirien.ci,https://www.rizivoirien.ci

# URL du frontend (utilisée dans les liens des emails)
FRONTEND_URL=https://rizivoirien.ci

# ── SMTP (emails transactionnels) ─────────────────────────────────────────────
# Si SMTP_HOST est vide, les emails sont simulés dans la console (mode dev).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.VOTRE_CLE_API
SMTP_FROM="RizIvoirien" <noreply@rizivoirien.ci>
