# ── Base de données ───────────────────────────────────────────────────────────
# Le schema.prisma est passé à PostgreSQL (obligatoire depuis le premier
# déploiement prod) — une base Postgres est désormais requise même en dev
# local (ex. instance gratuite Neon/Supabase, ou Postgres local/Docker).
DATABASE_URL="postgresql://user:password@host:5432/rizivoirien"

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGEZ_MOI_EN_PRODUCTION"

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
UPLOAD_DIR="uploads"
# Domaine public du backend — requis en production si CLOUDINARY_CLOUD_NAME
# n'est PAS configuré (les fichiers uploadés sont alors servis localement
# depuis /uploads et ont besoin d'une URL absolue). Inutile si Cloudinary est actif.
BASE_URL=https://api.rizivoirien.ci
# Niveau de log pino (trace|debug|info|warn|error). Défaut : info.
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origines autorisées en production, séparées par des virgules.
# Localhost est toujours autorisé en dev — cette variable n'est utilisée qu'en prod.
ALLOWED_ORIGINS=https://rizivoirien.ci,https://www.rizivoirien.ci

# URL du frontend (utilisée dans les liens des emails)
FRONTEND_URL=https://rizivoirien.ci

# ── SMTP (emails transactionnels) ─────────────────────────────────────────────
# Si SMTP_HOST est vide, les emails sont simulés dans la console (mode dev).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.VOTRE_CLE_API
SMTP_FROM="RizIvoirien" <noreply@rizivoirien.ci>

# ── Cloudinary (stockage des fichiers uploadés) ───────────────────────────────
# Si CLOUDINARY_CLOUD_NAME est vide, les uploads sont stockés localement sur le
# disque (uploads/) — non persistant sur la plupart des hébergeurs (ex. Render
# sans disque monté) : à configurer avant la mise en production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Observabilité (Sentry) ────────────────────────────────────────────────────
# Optionnel. Si vide, les erreurs serveur restent seulement loguées (pino), non
# remontées à Sentry.
SENTRY_DSN=

# ── Génération de fiche produit par IA (optionnel) ────────────────────────────
# Si vide, un générateur local (sans IA) est utilisé à la place.
ANTHROPIC_API_KEY=
