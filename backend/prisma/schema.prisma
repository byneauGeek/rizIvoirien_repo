generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("BUYER")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerified          Boolean   @default(false)
  emailVerifyToken       String?
  // LOT AUDIT-G5 (audit XXX RIZ) : le token de vérification email n'avait
  // aucune expiration (contrairement à resetToken/resetTokenExpiry) — un lien
  // intercepté restait valable indéfiniment. 48h, cohérent avec la nature
  // moins sensible de cette action (prouver la possession de l'email, pas une
  // prise de contrôle de compte) par rapport au reset mot de passe (1h).
  emailVerifyTokenExpiry DateTime?
  resetToken             String?
  resetTokenExpiry       DateTime?

  shop            Shop?
  driver          Driver?
  orders          Order[]          @relation("BuyerOrders")
  addresses       Address[]
  reviews         Review[]
  shopReviews     ShopReview[]
  wishlist        Wishlist[]
  notifications   Notification[]
  disputes        Dispute[]
  commercialNotes CommercialNote[] @relation("CommercialNoteAuthor")

  // ── Module B2B (filière riz) ──────────────────────────────────────────────
  producer    Producer?
  cooperative Cooperative?
  trader      Trader?
  processor   Processor?
  exporter    Exporter?

  contactsSent            ContactRequest[] @relation("ContactFrom")
  contactsReceived        ContactRequest[] @relation("ContactTo")
  b2bTransactionsAsBuyer  B2BTransaction[] @relation("B2BTransactionBuyer")
  b2bTransactionsAsSeller B2BTransaction[] @relation("B2BTransactionSeller")
  b2bReportsFiled         B2BReport[]

  // ── Comptabilité ─────────────────────────────────────────────────────────
  accountingPermissions AccountingPermission[]

  // ── Capacités additives (programme "Arbitrage XXX RIZ", LOT 2) ─────────────
  capabilities UserCapability[]

  // ── Messagerie entre acteurs ───────────────────────────────────────────────
  conversationsAsUserA Conversation[] @relation("ConversationUserA")
  conversationsAsUserB Conversation[] @relation("ConversationUserB")
  messagesSent         Message[]

  // ── Signatures de contrat ──────────────────────────────────────────────────
  contractSignatures ContractSignature[]

  // ── Support ────────────────────────────────────────────────────────────────
  supportTickets         SupportTicket[]        @relation("SupportTicketOwner")
  assignedSupportTickets SupportTicket[]        @relation("SupportTicketAssignee")
  supportMessagesSent    SupportTicketMessage[]
}

// Un compte a un rôle PRINCIPAL unique (User.role, inchangé — détermine la
// redirection post-connexion et reste le comportement par défaut pour 100%
// des comptes existants). Ce modèle ajoute des capacités SECONDAIRES,
// cumulables, sans jamais toucher au rôle principal ni exiger un nouveau
// compte — ex. un BUYER qui active la capacité TRADER garde son compte, son
// historique de commandes B2C, et gagne l'accès aux routes B2B réservées à
// TRADER. Vérifié par requireRole() dans middleware/auth.js, chargé à chaque
// requête (pas embarqué dans le JWT) : une capacité activée est effective dès
// la requête suivante, sans réémission de token ni reconnexion.
model Conversation {
  id          Int       @id @default(autoincrement())
  // "ORDER" | "SHIPMENT" | "B2B_TRANSACTION" — chaque conversation est
  // scopée à un contexte transactionnel existant plutôt qu'un DM générique
  // ouvert (cf. audit messagerie XXX RIZ) : les deux participants et leur
  // droit de se parler se déduisent déjà de ce contexte (Order.buyerId +
  // Shop.userId, Shipment.driverId, B2BTransaction.buyerUserId/sellerUserId).
  contextType String
  contextId   Int
  userAId     Int
  userA       User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId     Int
  userB       User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contextType, contextId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model UserCapability {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // même vocabulaire que User.role (ex. "TRADER")
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
}

// ─── B2B : profils ──────────────────────────────────────────────────────────

model Producer {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  region          String
  department      String?
  commune         String?
  locality        String?
  farmType        String?
  surfaceHa       Float?
  capacityKg      Float?
  photo           String?
  description     String?
  // LOT AUDIT-G13 (audit XXX RIZ) : gap confirmé — l'admin pouvait passer un
  // profil B2B en VERIFIED sans qu'aucune pièce (RCCM, identité...) n'ait
  // jamais été fournie, la vérification reposant uniquement sur des champs
  // texte déclarés. Même convention que Producer.photo/Driver.idPhoto :
  // une URL (photo du document), pas un upload PDF dédié — éditable par le
  // titulaire via PUT /b2b/my-profile, visible par l'admin (spread `...p`
  // déjà existant dans GET /admin/b2b/verifications).
  documentUrl     String?
  verification    String   @default("UNVERIFIED") // UNVERIFIED|PENDING|VERIFIED|SUSPENDED
  // LOT AUDIT-B2B-03 (audit XXX RIZ) : REJECTED n'est pas un statut stocké
  // (retombe sur UNVERIFIED, cf. b2bAdmin.js) — sans ce champ, un refus était
  // indiscernable de "jamais candidaté", et le motif du refus perdu. Effacé à
  // chaque nouvelle soumission (request-verification) et à chaque décision
  // admin autre que REJECTED, pour ne jamais afficher un motif obsolète.
  rejectionReason String?
  // LOT GEOLOC (retour utilisateur) : solution additionnelle aux champs
  // region/department/commune/locality existants.
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cooperativeMemberships CooperativeMember[]
  offers                 RiceOffer[]
  ownedOffers            RiceOffer[]              @relation("RiceOfferOwner")
  ownedTransactions      B2BTransaction[]         @relation("B2BTransactionOwner")
  ledgerEntries          CooperativeLedgerEntry[]

  @@index([region])
  @@index([verification])
}

model Cooperative {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  responsable     String
  region          String
  zone            String?
  description     String?
  documentUrl     String? // LOT AUDIT-G13 — cf. commentaire sur Producer.documentUrl
  verification    String   @default("UNVERIFIED")
  rejectionReason String? // LOT AUDIT-B2B-03 — cf. commentaire sur Producer.rejectionReason
  // LOT AUDIT-ACC-05 (audit XXX RIZ) : taux de commission que la coopérative
  // prélève sur chaque vente d'un membre (%), configurable par la coopérative
  // elle-même — jamais un taux plateforme (la plateforme n'encaisse jamais
  // l'argent des transactions B2B, cf. remuneration.js). 0 par défaut : pas de
  // commission tant que la coopérative ne configure rien explicitement.
  commissionRate  Float    @default(0)
  // LOT GEOLOC (retour utilisateur) : solution additionnelle au champ region/
  // zone existant — mêmes champs que Shop.latitude/longitude.
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members       CooperativeMember[]
  offers        RiceOffer[]
  ledgerEntries CooperativeLedgerEntry[]
  invoices      CooperativeInvoice[]

  @@index([region])
  @@index([verification])
}

// LOT AUDIT-ACC-05 (audit XXX RIZ) : gap confirmé — aucun modèle financier
// ne référençait Producer/CooperativeMember (Debt/Receivable/FinancialTransaction
// pointent exclusivement vers User/Driver/Shop), et remuneration.js documente
// lui-même que la plateforme n'encaisse jamais l'argent des transactions B2B.
// Ledger DÉCLARATIF interne à la coopérative (jamais un pipeline de paiement
// de plateforme) : SALE_CREDIT/COMMISSION générés automatiquement à la
// déclaration d'une transaction (LOT OWN-03), PAYMENT/ADJUSTMENT saisis
// manuellement par le responsable — append-only, jamais modifié après coup
// (une correction s'ajoute comme un nouveau mouvement ADJUSTMENT, ne réécrit
// jamais un mouvement passé). Solde = somme signée de amount (positif =
// crédit au membre, négatif = débit), même convention que StockMovement.
model CooperativeLedgerEntry {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  producerId    Int
  producer      Producer    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  type          String // SALE_CREDIT|COMMISSION|PAYMENT|ADJUSTMENT
  amount        Float // signé : positif = crédit membre, négatif = débit
  sourceType    String? // B2B_TRANSACTION|MANUAL
  sourceId      Int?
  reference     String?
  description   String?
  authorUserId  Int?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, producerId])
  @@index([sourceType, sourceId])
}

// LOT AUDIT-ACC-01 (audit XXX RIZ) : gap confirmé — aucun modèle Invoice/
// Facture n'existait (recherche exhaustive du schéma). Une seule facture par
// transaction (contrainte @unique) — même pattern que Contract
// (contractGenerator.js) : HTML généré et stocké côté serveur, rendu +
// export PDF côté client (html2pdf.js), pas de moteur de facturation
// parallèle ni de PDF stocké côté serveur.
model CooperativeInvoice {
  id            Int            @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative    @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  transactionId Int            @unique
  transaction   B2BTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoiceNumber String         @unique
  content       String
  createdAt     DateTime       @default(now())

  @@index([cooperativeId])
}

model CooperativeMember {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  producerId    Int
  producer      Producer    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())
  // LOT AUDIT-ORG-02 (audit XXX RIZ) : gap confirmé — seuls list/add/delete
  // (suppression définitive) existaient, aucune désactivation réversible ni
  // note interne à la coopérative sur ce membre. `active=false` retire le
  // membre des ventes/attributions courantes sans perdre l'historique
  // d'adhésion (joinedAt) ni ses ventes passées — contrairement à DELETE,
  // qui reste disponible pour un retrait définitif (ex. erreur de saisie).
  active        Boolean     @default(true)
  note          String?

  @@unique([cooperativeId, producerId])
  @@index([cooperativeId, active])
}

model Trader {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  companyName     String
  activity        String?
  zones           String?
  documentUrl     String? // LOT AUDIT-G13 — cf. commentaire sur Producer.documentUrl
  verification    String   @default("UNVERIFIED")
  rejectionReason String? // LOT AUDIT-B2B-03 — cf. commentaire sur Producer.rejectionReason
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

model Processor {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  companyName     String
  zones           String?
  documentUrl     String? // LOT AUDIT-G13 — cf. commentaire sur Producer.documentUrl
  verification    String   @default("UNVERIFIED")
  rejectionReason String? // LOT AUDIT-B2B-03 — cf. commentaire sur Producer.rejectionReason
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

model Exporter {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  companyName     String
  capacityKg      Float?
  zones           String?
  documentUrl     String? // LOT AUDIT-G13 — cf. commentaire sur Producer.documentUrl
  verification    String   @default("UNVERIFIED")
  rejectionReason String? // LOT AUDIT-B2B-03 — cf. commentaire sur Producer.rejectionReason
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

// ─── B2B : offres & demandes ────────────────────────────────────────────────

model RiceOffer {
  id               Int          @id @default(autoincrement())
  producerId       Int?
  producer         Producer?    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  cooperativeId    Int?
  cooperative      Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  product          String // "Riz paddy" | "Riz blanchi"
  variety          String?
  quantity         Float
  unit             String // kg | tonne | sac
  region           String
  availableFrom    DateTime?
  quality          String?
  price            Float?
  // LOT B2B-7 (audit XXX RIZ) : MOQ (quantité minimale de commande) —
  // absente jusqu'ici, `quantity` ne représentait que le stock total
  // disponible, jamais un seuil minimum d'achat par commande. Nullable :
  // une offre sans MOQ reste vendable à l'unité, comportement inchangé pour
  // les offres existantes.
  minOrderQty      Float?
  photos           String       @default("[]")
  status           String       @default("DRAFT") // DRAFT|AVAILABLE|RESERVED|SOLD|EXPIRED|DISABLED
  // LOT AUDIT-OWN-01 (audit XXX RIZ) : gap confirmé — une offre publiée par
  // une COOPERATIVE (cooperativeId renseigné) n'avait aucun moyen d'indiquer
  // que la marchandise appartient en réalité à un membre précis plutôt qu'à
  // la coopérative elle-même. Relation distincte de `producerId` (qui reste
  // "auteur de l'offre" pour un producteur publiant en son nom propre) —
  // `ownerProducerId` n'est utilisé QUE sur une offre à `cooperativeId` non
  // nul. Null = propriété de la coopérative (règle explicite, jamais une
  // absence ambiguë) ; non-null = doit référencer un membre réel de CETTE
  // coopérative (vérifié en route, pas en contrainte DB — CooperativeMember
  // n'est pas une simple FK 1:1).
  ownerProducerId  Int?
  ownerProducer    Producer?    @relation("RiceOfferOwner", fields: [ownerProducerId], references: [id])
  // LOT APPROVAL (audit XXX RIZ) : même logique que Product.moderationStatus
  // — orthogonal au `status` métier existant (DRAFT|AVAILABLE|...), qui
  // reste géré librement par le producteur/coopérative. Défaut APPROVED
  // pour ne pas invisibiliser rétroactivement les offres déjà publiées.
  moderationStatus String       @default("APPROVED") // PENDING_REVIEW | APPROVED | REJECTED
  rejectionReason  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  contactRequests ContactRequest[]

  @@index([status])
  @@index([region])
  @@index([product])
  @@index([producerId])
  @@index([cooperativeId])
  @@index([ownerProducerId])
  @@index([moderationStatus])
}

model PurchaseRequest {
  id           Int        @id @default(autoincrement())
  traderId     Int?
  trader       Trader?    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  processorId  Int?
  processor    Processor? @relation(fields: [processorId], references: [id], onDelete: Cascade)
  exporterId   Int?
  exporter     Exporter?  @relation(fields: [exporterId], references: [id], onDelete: Cascade)
  product      String
  quantity     Float
  unit         String
  region       String
  period       String?
  requirements String?
  status       String     @default("ACTIVE") // DRAFT|ACTIVE|FULFILLED|EXPIRED|CANCELLED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contactRequests ContactRequest[]

  @@index([status])
  @@index([region])
  @@index([product])
  @@index([traderId])
  @@index([processorId])
  @@index([exporterId])
}

// ─── B2B : mise en relation & transaction déclarée ──────────────────────────
// Le contact est le SEUL mécanisme qui révèle les coordonnées entre deux
// utilisateurs B2B (voir b2bContact.js) — jamais exposées directement sur une
// offre/demande publique.
model ContactRequest {
  id         Int              @id @default(autoincrement())
  fromUserId Int
  fromUser   User             @relation("ContactFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User             @relation("ContactTo", fields: [toUserId], references: [id])
  offerId    Int?
  offer      RiceOffer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  requestId  Int?
  request    PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  message    String?
  status     String           @default("PENDING") // PENDING|ACCEPTED|REJECTED
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  transaction B2BTransaction?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model B2BTransaction {
  id              Int             @id @default(autoincrement())
  contactId       Int?            @unique
  contact         ContactRequest? @relation(fields: [contactId], references: [id])
  buyerUserId     Int
  buyer           User            @relation("B2BTransactionBuyer", fields: [buyerUserId], references: [id])
  sellerUserId    Int
  seller          User            @relation("B2BTransactionSeller", fields: [sellerUserId], references: [id])
  product         String
  quantity        Float
  unit            String
  region          String
  amount          Float?
  // LOT 2 (Arbitrage XXX RIZ) : DECLARED restait un simple enregistrement
  // déclaratif — IN_TRANSIT/DELIVERED/ESCALATED ajoutés pour permettre le même
  // miroir de statut que Order (voir deliveryLifecycle.js), une fois qu'un
  // Shipment est rattaché via needsLogistics. Une transaction SANS logistique
  // (needsLogistics=false) reste DECLARED|CANCELLED comme avant — aucun
  // changement de comportement pour l'usage B2B existant.
  status          String          @default("DECLARED") // DECLARED|CANCELLED|IN_TRANSIT|DELIVERED|ESCALATED
  notes           String?
  // LOT AUDIT-OWN-03 (audit XXX RIZ) : gap confirmé — structurellement
  // impossible jusqu'ici de savoir à quel membre une vente devait être
  // attribuée (aucun champ n'existait). Snapshot au moment de la déclaration
  // depuis RiceOffer.ownerProducerId — jamais recalculé depuis l'offre
  // ensuite : "une fois la vente terminée, ne pas dépendre du stock courant
  // pour retrouver le propriétaire" (l'offre peut changer de propriétaire ou
  // être modifiée après coup, la transaction doit rester figée).
  ownerProducerId Int?
  ownerProducer   Producer?       @relation("B2BTransactionOwner", fields: [ownerProducerId], references: [id])
  createdAt       DateTime        @default(now())

  // Logistique B2B (LOT 2) — renseignés uniquement si needsLogistics=true.
  // deliveryFee est saisi manuellement (comme les rémunérations COOPERATIVE/
  // EMPLOYEE en comptabilité) tant que la tarification par zone/volume
  // (lot ultérieur) n'est pas branchée : jamais un montant inventé par le
  // système, toujours une décision explicite de qui organise la livraison.
  needsLogistics       Boolean             @default(false)
  deliveryAddress      String?
  deliveryFee          Float?
  // LOT 6 (Arbitrage XXX RIZ) : deliveryFee peut désormais être auto-calculé
  // via la grille PricingRule (segment=B2B_CARGO) au lieu d'être une saisie
  // manuelle obligatoire (voir commentaire historique ci-dessus, LOT2) — la
  // saisie manuelle reste possible (décision explicite qui prime toujours sur
  // le calcul automatique), jamais supprimée. Mêmes champs de décomposition
  // que Order pour la même raison.
  serviceLevel         String              @default("STANDARD")
  deliveryInternalCost Float?
  deliveryMargin       Float?
  shipment             Shipment?
  invoice              CooperativeInvoice?

  @@index([buyerUserId])
  @@index([sellerUserId])
  @@index([status])
}

model B2BReport {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String // PROFILE | OFFER | REQUEST
  targetId   Int
  reason     String
  status     String   @default("PENDING") // PENDING|REVIEWING|RESOLVED|REJECTED
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// Listes de référence gérables par l'admin (cahier de cadrage §16 : "gestion
// des catégories, régions, produits et unités"). Volontairement une simple
// table valeur/type plutôt que 3 modèles séparés — aucune autre table ne
// pointe vers elle par clé étrangère (region/product/unit restent des champs
// texte libres sur RiceOffer/PurchaseRequest), elle ne fait qu'alimenter les
// suggestions affichées côté frontend.
model B2BReferenceItem {
  id     Int     @id @default(autoincrement())
  type   String // REGION | PRODUCT | UNIT
  value  String
  active Boolean @default(true)

  @@unique([type, value])
  @@index([type, active])
}

model Shop {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id])
  // Identité
  name               String
  slug               String    @unique
  businessName       String?
  rccm               String?
  description        String?
  speciality         String?
  since              String?
  // Contact
  phone              String?
  email              String?
  // Localisation
  location           String?
  latitude           Float?
  longitude          Float?
  deliveryZones      String?
  // Médias
  coverImage         String?
  avatar             String?
  // Opérationnel
  minOrder           Float     @default(0)
  preparationTime    Int       @default(30)
  openingHours       String?
  paused             Boolean   @default(false)
  pauseNote          String?
  // Notifications
  notifyEmail        Boolean   @default(true)
  notifyLowStock     Boolean   @default(true)
  // Contact social
  whatsapp           String?
  facebook           String?
  instagram          String?
  // Vente
  paymentMethods     String    @default("[]")
  tags               String?
  // Annonce temporaire
  announcement       String?
  announcementActive Boolean   @default(false)
  // Statut & plan
  status             String    @default("PENDING")
  active             Boolean   @default(false)
  plan               String    @default("BASIC")
  certified          Boolean   @default(false)
  // Métriques
  rating             Float     @default(5.0)
  reviewCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  contractSigned     Boolean   @default(false)
  contract           Contract?
  // Logistique (LOT 4) — rattachement optionnel à une zone de livraison,
  // posé pour un usage futur (tarification, hubs) : non lu par le moteur
  // d'affectation ni par la tarification à ce lot (arbitrage Décision 6, Option B).
  zoneId             Int?
  zone               Zone?     @relation(fields: [zoneId], references: [id])

  products            Product[]
  orders              Order[]
  subscription        Subscription?
  shopReviews         ShopReview[]
  planUpgradeRequests PlanUpgradeRequest[]
  commercialNotes     CommercialNote[]

  @@index([zoneId])
}

model Product {
  id               Int      @id @default(autoincrement())
  shopId           Int
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name             String
  slug             String   @unique
  description      String?
  category         String
  price            Float
  unit             String   @default("5kg")
  pricePerKg       Float    @default(0)
  stock            Int      @default(0)
  images           String   @default("[]")
  badge            String?
  origin           String?
  harvest          String?
  // RETAIL = détail uniquement | WHOLESALE = gros uniquement | BOTH = gros & détail
  saleType         String   @default("BOTH")
  wholesalePrice   Float?
  minWholesaleQty  Int?
  rating           Float    @default(5.0)
  reviewCount      Int      @default(0)
  active           Boolean  @default(true)
  // LOT APPROVAL (audit XXX RIZ) : jusqu'ici, `active` était le SEUL
  // interrupteur — un produit créé était public instantanément, aucune
  // règle ni contrôle admin. moderationStatus est orthogonal à `active`
  // (le vendeur garde son interrupteur vitrine, indépendant de la
  // modération) : un produit doit être `active: true` ET
  // `moderationStatus: 'APPROVED'` pour apparaître publiquement.
  // Défaut APPROVED ici pour que la migration n'invisibilise pas
  // rétroactivement les produits déjà en ligne — seules les créations
  // futures passent explicitement par l'évaluation des règles
  // (services/approvalEngine.js), qui fixe toujours la vraie valeur.
  moderationStatus String   @default("APPROVED") // PENDING_REVIEW | APPROVED | REJECTED
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  wishlist      Wishlist[]
  history       ProductHistory[]
  stockPosition StockPosition?
  variants      ProductVariant[]

  @@index([shopId])
  @@index([active])
  @@index([saleType])
  @@index([moderationStatus])
}

// LOT VARIANTS (retour utilisateur) : jusqu'ici, deux tailles de sac
// (25kg/50kg) du "même" riz exigeaient deux fiches Product entièrement
// séparées (stock, prix, modération indépendants) — aucun moyen de les
// présenter comme un seul article avec un choix de conditionnement à la
// confirmation de commande. Additif et optionnel : un Product sans variante
// se comporte EXACTEMENT comme avant (son propre unit/price/stock restent la
// "taille de base") ; ProductVariant n'ajoute que des tailles SUPPLÉMENTAIRES
// avec leur propre prix et stock, jamais un remplacement des champs
// existants — zéro migration de données, zéro changement de comportement
// pour les produits mono-taille déjà en ligne.
model ProductVariant {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit            String // "50kg", "sac de 100kg"... même vocabulaire libre que Product.unit
  price           Float
  pricePerKg      Float    @default(0)
  stock           Int      @default(0)
  wholesalePrice  Float?
  minWholesaleQty Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
  movements  VariantStockMovement[]

  @@unique([productId, unit])
  @@index([productId])
  @@index([active])
}

// Mouvements de stock PROPRES aux variantes — mécanisme volontairement
// séparé du Stock Engine existant (services/stockEngine.js, productId
// unique par StockPosition) plutôt que d'y injecter un variantId optionnel :
// ce moteur est central, déjà éprouvé et utilisé partout où Product.stock
// compte, le risque de régression d'y toucher dépasse le bénéfice ici. Même
// garantie d'atomicité (increment/decrement signé côté SQL, jamais négatif),
// juste sur sa propre table.
model VariantStockMovement {
  id             Int            @id @default(autoincrement())
  variantId      Int
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type           String // INITIAL_STOCK | SALE | RESTOCK | ADJUSTMENT
  quantity       Int // signé : positif = entrée, négatif = sortie
  quantityBefore Int
  quantityAfter  Int
  sourceType     String? // ORDER | MANUAL
  sourceId       Int?
  reason         String?
  actorId        Int?
  createdAt      DateTime       @default(now())

  @@index([variantId])
  @@index([type])
}

// ═══════════════════════════════════════════════════════════════════════════
// STOCK ENGINE — LOT 1 : modèles fondation (audit du 2026-09-05).
// Product.stock (champ historique ci-dessus) reste en place comme cache
// affiché par le reste de l'app ; StockPosition.quantity devient la source de
// vérité à partir du LOT 3, synchronisée vers Product.stock à chaque
// mouvement (double écriture transitoire, cf. plan de migration de l'audit).
// Ne JAMAIS écrire StockPosition.quantity directement — toujours passer par
// le Stock Engine (services/stockEngine.js, LOT 2) qui produit le
// StockMovement correspondant dans la même transaction.
// ═══════════════════════════════════════════════════════════════════════════

model StockPosition {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([productId])
}

// Journal append-only — jamais modifié ni supprimé après création (même
// convention de traçabilité que FinancialTransaction/AdminLog). sourceType/
// sourceId reprend le pattern polymorphe déjà utilisé par FinancialTransaction/
// Debt/AccountingDocument plutôt que des clés étrangères dédiées par origine.
model StockMovement {
  id              Int           @id @default(autoincrement())
  stockPositionId Int
  stockPosition   StockPosition @relation(fields: [stockPositionId], references: [id], onDelete: Cascade)
  productId       Int // dénormalisé — évite une jointure pour toute requête "mouvements de ce produit"
  type            String // INITIAL_STOCK|RECEPTION|SALE|RESTOCK|ADJUSTMENT|LOSS|INVENTORY_ADJUSTMENT
  quantity        Int // signé : positif = entrée, négatif = sortie
  quantityBefore  Int
  quantityAfter   Int
  sourceType      String? // ORDER|MANUAL|MIGRATION|INVENTORY|DISPUTE
  sourceId        Int?
  reason          String?
  actorId         Int? // utilisateur à l'origine — Int simple sans relation formelle, comme OrderStatusHistory.actorId/AdminLog.adminId (null pour un mouvement système, ex. MIGRATION)
  createdAt       DateTime      @default(now())

  @@index([stockPositionId])
  @@index([productId])
  @@index([type])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model ProductHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId   Int
  actorName String
  changes   String // JSON : { field: { from, to, label } }[]
  createdAt DateTime @default(now())
}

model Order {
  id                   Int       @id @default(autoincrement())
  // LOT NUMEROTATION (retour utilisateur) : jusqu'ici affiché uniquement en
  // reformatant l'id brut à la volée (CMD-2026-00042, jamais persisté, donc
  // jamais garanti unique/séquentiel en soi — juste l'id). Référence réelle,
  // générée à la création via services/accountingSequence.js (même mécanisme
  // atomique déjà utilisé pour FinancialTransaction/Remuneration/PaymentOrder/
  // Payment/Expense — pas un nouveau compteur parallèle). Nullable : les
  // commandes déjà existantes n'en ont pas et retombent sur l'ancien format
  // d'affichage côté frontend, jamais de backfill rétroactif d'une séquence.
  // v2 (retour utilisateur, format jugé "trop générique") : initiales de
  // boutique + compteur PROPRE à cette boutique (ex. RDB-0001) plutôt qu'un
  // compteur global daté — unique par (shopId, reference), pas globalement :
  // deux boutiques aux initiales identiques peuvent en théorie produire la
  // même chaîne affichée, cas rarissime et sans ambiguïté réelle pour
  // l'acheteur/vendeur (jamais comparés entre boutiques), préférable à des
  // initiales moins lisibles pour l'éliminer entièrement.
  reference            String?
  buyerId              Int
  buyer                User      @relation("BuyerOrders", fields: [buyerId], references: [id])
  shopId               Int
  shop                 Shop      @relation(fields: [shopId], references: [id])
  driverId             Int?
  driver               Driver?   @relation(fields: [driverId], references: [id])
  status               String    @default("PENDING")
  total                Float
  deliveryFee          Float     @default(0)
  discount             Float     @default(0)
  promoCode            String?
  address              String
  note                 String?
  // LOT 6 (Arbitrage XXX RIZ) : deliveryFee reste le prix CLIENT (déjà
  // existant). deliveryInternalCost/deliveryMargin sont la décomposition
  // financière (coût réel plateforme / marge ou subvention) quand une
  // PricingRule a été appliquée — null si le calcul est retombé sur l'ancien
  // forfait (aucune règle configurée pour ce corridor). serviceLevel choisi
  // par l'acheteur à la commande, indépendant du segment (implicite B2C =
  // SMALL_MEDIUM ici, pas stocké car non ambigu pour ce modèle).
  serviceLevel         String    @default("STANDARD") // ECONOMIC | STANDARD | EXPRESS
  deliveryInternalCost Float?
  deliveryMargin       Float?
  groupId              String?
  idempotencyKey       String?
  paymentMethod        String    @default("CASH_ON_DELIVERY")
  driverRated          Boolean   @default(false)
  // LOT AUDIT-G11 (audit XXX RIZ) : PENDING_VALIDATION bloquait le stock
  // indéfiniment si personne ne traitait la commande. orderValidationExpiry.js
  // avertit le staff commercial à 24h puis annule+restocke à 48h ; ce champ
  // évite de renvoyer l'alerte à chaque passage du moteur (horaire).
  expiryWarnedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  driverOffer   DriverOffer?
  dispute       Dispute?
  shipment      Shipment?

  @@unique([buyerId, idempotencyKey])
  @@unique([shopId, reference])
  @@index([buyerId])
  @@index([shopId])
  @@index([driverId])
  @@index([status])
  @@index([groupId])
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  // LOT VARIANTS : null = taille de base du produit (comportement historique
  // inchangé) ; non-null = variante choisie. `unitLabel` fige le libellé de
  // taille au moment de la commande (ex. "50kg") — jamais recalculé depuis la
  // variante, qui peut être renommée/supprimée ensuite sans que l'historique
  // de commande ne change (même logique que `name`, déjà un instantané du nom
  // produit, et que B2BTransaction.ownerProducerId ailleurs dans ce projet).
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  unitLabel String?
  quantity  Int
  price     Float
  name      String

  @@index([variantId])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  actorId   Int?
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// LOGISTIQUE — LOT 3 : Fulfillment + Shipments (arbitrage Décision 3, Option C).
// Décorrèle l'EXÉCUTION logistique (Shipment) de l'objet commercial (Order),
// même principe déjà appliqué à StockMovement (Product) et Payment (Order) —
// pas une architecture nouvelle, la continuation du même patron.
//
// 1:1 avec Order pour l'instant (une commande = une livraison) — le passage
// à un modèle 1:N (plusieurs colis par commande) n'exigerait alors qu'un
// retrait de `@unique` sur orderId, pas une refonte.
//
// Order.status continue d'être mis à jour en miroir à chaque transition
// (services/deliveryLifecycle.js) : les 9 consommateurs existants
// (disputes, avis, analytics, rémunération...) qui lisent Order.status
// directement continuent de fonctionner sans modification.
// ═══════════════════════════════════════════════════════════════════════════
// LOT 2 (Arbitrage XXX RIZ) : orderId devient optionnel — un Shipment peut
// désormais naître d'une Order B2C (comme avant, `orderId` renseigné) OU
// d'un B2BTransaction (`b2bTransactionId` renseigné) — EXACTEMENT L'UN DES
// DEUX, jamais les deux ni aucun (contrainte vérifiée en application, Prisma/
// SQLite ne portant pas de CHECK constraint multi-colonnes ici). Choix
// délibéré de deux FK nullables plutôt qu'un couple générique
// sourceType/sourceId (patron déjà utilisé par StockMovement) : Shipment a
// besoin de vraies relations Prisma navigables (order.items, b2bTransaction),
// pas seulement d'un identifiant brut pour l'audit.
// TOUTE la logique de branchement B2C/B2B reste confinée à
// services/deliveryLifecycle.js (point d'entrée unique déjà établi au LOT3) —
// vérifié par grep : aucun autre fichier ne lit shipment.order directement,
// sauf orders.js GET /:id/track (suivi acheteur, intrinsèquement B2C,
// continue de fonctionner sans changement puisque orderId reste peuplé pour
// tout Shipment B2C existant ou nouveau).
model Shipment {
  id               Int             @id @default(autoincrement())
  orderId          Int?            @unique
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  b2bTransactionId Int?            @unique
  b2bTransaction   B2BTransaction? @relation(fields: [b2bTransactionId], references: [id], onDelete: Cascade)
  driverId         Int?
  driver           Driver?         @relation(fields: [driverId], references: [id])
  status           String          @default("PENDING_PICKUP")
  // PENDING_PICKUP | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED | CANCELLED
  pickupAddress    String?
  dropoffAddress   String
  // LOT 8 : géocodage paresseux (1re requête de suivi client, pas à la
  // création — voir orders.js GET /:id/track) pour calculer une ETA réelle.
  // null tant que non géocodé ou si le géocodage échoue — l'ETA est alors
  // simplement absente, jamais une erreur.
  dropoffLat       Float?
  dropoffLng       Float?
  weightKg         Float?
  distanceKm       Float?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // LOT 9 : preuve de livraison — était totalement ABSENTE avant ce lot
  // (n'importe qui avec le compte du livreur pouvait marquer DELIVERED sans
  // aucune vérification). Code à 4 chiffres généré au passage PICKED_UP,
  // envoyé à l'acheteur par e-mail, exigé du livreur pour passer DELIVERED.
  // deliveryCodeAttempts limite le brute-force (verrouillage après 5 essais).
  // deliveryProofDistanceKm est un signal ADDITIONNEL, informatif seulement
  // (utile en cas de litige) — jamais bloquant, car la destination n'est pas
  // toujours géocodée (LOT8, best-effort) au moment de la livraison.
  deliveryCode            String?
  deliveryCodeAttempts    Int     @default(0)
  deliveryProofDistanceKm Float?

  events             ShipmentEvent[]
  verificationTokens DeliveryVerificationToken[]
  routeStop          RouteStop?

  @@index([driverId])
  @@index([status])
  // LOT 16 : GET /admin/logistics/dashboard et /risk-signals (LOT14/15)
  // filtrent par statut + fenêtre updatedAt sur potentiellement toute la
  // table Shipment — sans cet index composite, une table qui grossit force
  // un scan complet à chaque consultation du tableau de bord.
  @@index([status, updatedAt])
}

// LOT 3 (Arbitrage XXX RIZ) : QR dynamique — mécanisme PRINCIPAL de preuve de
// livraison, l'OTP (deliveryCode, LOT9) devenant son fallback contrôlé.
// `token` : valeur aléatoire opaque (32 octets, hex), PAS l'id du shipment ni
// aucun identifiant exploitable — c'est la valeur encodée dans le QR affiché
// à l'acheteur. Conservée en clair (pas hachée) : elle doit pouvoir être
// re-servie à l'acheteur à chaque poll de /orders/:id/track (LOT8, toutes les
// 10s) tant qu'elle est active, ce qu'un hash à sens unique interdirait —
// même compromis déjà accepté pour deliveryCode (LOT9). La sécurité vient de
// la longueur (non devinable), de l'expiration courte (qrTokenTtlMinutes) et
// de l'usage unique (usedAt), jamais exposée au livreur (voir drivers.js).
model DeliveryVerificationToken {
  id         Int       @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([shipmentId])
}

// LOT 9 (arbitrage Décision 4) : historique GPS, absent jusqu'ici (seule la
// DERNIÈRE position était conservée, DriverCurrentLocation). Politique de
// rétention définie ici : purge opportuniste à chaque nouvelle position
// envoyée (voir drivers.js POST /location), pas de tâche planifiée séparée —
// PlatformSettings.gpsHistoryRetentionDays fixe la durée (30 jours par défaut).
model DriverLocationHistory {
  id        Int      @id @default(autoincrement())
  driverId  Int
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId   Int?
  lat       Float
  lng       Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
  @@index([orderId])
}

model ShipmentEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  actorId    Int?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// Logistique — LOT 4 : Architecture logistique (arbitrage Décision 6, Option B).
// Ces 3 modèles posent le SCHÉMA d'une architecture logistique par
// zones/hubs/catégories de véhicule. Ils ne sont PAS lus par le moteur
// d'affectation (assignmentEngine.js reste 1 livreur ↔ 1 commande) ni par
// le calcul du tarif de livraison à ce lot — ce sera le travail des lots
// suivants (LOT5 affectation, LOT6 tarification) une fois ces données
// disponibles et administrées. Aucune tournée/optimisation de trajet
// (Route/Stop) n'est introduite : hors-scope, explicitement refusé à
// l'arbitrage.

// Catalogue des catégories de véhicule et de leur capacité — remplace le
// besoin de coder en dur une capacité par type dans le calcul tarifaire
// (LOT6). Driver.vehicleType (chaîne libre existante) n'est PAS modifié
// par ce lot pour ne casser aucun consommateur existant (inscription,
// profil livreur, génération de contrat) ; le rapprochement des deux se
// fera par convention de code au moment de l'usage réel en LOT6.
model VehicleType {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  label          String
  capacityKg     Float
  // LOT 6 : plafond de frais de livraison propre à cette catégorie. Optionnel
  // pour rester rétro-compatible — quand absent, calcDeliveryFee() retombe sur
  // PlatformSettings.deliveryMaxPrice (comportement d'avant ce lot).
  maxDeliveryFee Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Zone {
  id        Int      @id @default(autoincrement())
  name      String
  city      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops                     Shop[]
  hubs                      Hub[]
  // LOT 6 (Arbitrage XXX RIZ) : une Zone peut apparaître comme origine ET
  // comme destination dans la grille tarifaire (deux relations distinctes,
  // sinon Prisma ne sait pas quel FK de PricingRule appartient à laquelle).
  pricingRulesAsOrigin      PricingRule[] @relation("PricingRuleOrigin")
  pricingRulesAsDestination PricingRule[] @relation("PricingRuleDestination")
}

// LOT 6 (Arbitrage XXX RIZ, décision "tarification par zone réellement
// branchée") : remplace le forfait unique (base + poids + distance, LOT6 du
// programme précédent) par une grille à 3 axes INDÉPENDANTS — SEGMENT (nature
// du fret : B2C consommateur vs B2B cargo), SERVICE_LEVEL (rapidité choisie
// par le client) et corridor (zone d'origine -> zone de destination). Le prix
// client n'est jamais un pourcentage du montant de la commande — toujours
// recalculé depuis poids/distance/colis/origines/arrêts, mais avec des
// coefficients qui dépendent maintenant de ces 3 axes plutôt que d'être
// globaux. originZoneId/destinationZoneId à null = joker (repli progressif :
// corridor précis > joker), même logique que resolveMaxFee() pour VehicleType.
// Si AUCUNE règle n'est configurée pour un (segment, serviceLevel) donné, le
// moteur retombe sur l'ancien calcul (PlatformSettings + VehicleType) —
// jamais de rupture, migration progressive pièce par pièce de la grille.
model PricingRule {
  id           Int    @id @default(autoincrement())
  segment      String // SMALL_MEDIUM | B2B_CARGO
  serviceLevel String // ECONOMIC | STANDARD | EXPRESS

  originZoneId      Int?
  originZone        Zone? @relation("PricingRuleOrigin", fields: [originZoneId], references: [id])
  destinationZoneId Int?
  destinationZone   Zone? @relation("PricingRuleDestination", fields: [destinationZoneId], references: [id])

  // Coût interne (ce que la livraison coûte réellement à la plateforme) :
  basePrice           Float
  pricePerKg          Float    @default(0)
  pricePerKm          Float    @default(0)
  pricePerPackage     Float    @default(0) // au-delà du 1er colis
  pricePerExtraOrigin Float    @default(0) // ramassages multiples (paniers multi-boutiques, LOT2 B2B)
  pricePerExtraStop   Float    @default(0) // multi-arrêts (LOT7 à venir)
  // Prix CLIENT = coût interne * (1 + marginPct) — jamais l'inverse (le coût
  // interne n'est jamais dérivé du prix affiché). Une marge négative est une
  // subvention plateforme assumée, pas une erreur.
  marginPct           Float    @default(0.20)
  maxDeliveryFee      Float?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // NB : l'unicité ne bloque pas deux jokers (originZoneId ET
  // destinationZoneId null) pour le même segment+serviceLevel — NULL n'est
  // jamais égal à NULL dans une contrainte UNIQUE SQL. Ce cas (rare, erreur de
  // configuration admin) est contrôlé côté applicatif (routes admin), pas ici.
  @@unique([segment, serviceLevel, originZoneId, destinationZoneId])
  @@index([originZoneId])
  @@index([destinationZoneId])
}

model Hub {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  zoneId    Int?
  zone      Zone?    @relation(fields: [zoneId], references: [id])
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

model Driver {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  inviteCode      String    @unique
  // Statut
  status          String    @default("PENDING")
  online          Boolean   @default(false)
  available       Boolean   @default(true)
  // Identité
  avatar          String?
  idNumber        String?
  idPhoto         String?
  // Permis
  licenseNumber   String?
  licenseExpiry   String?
  licensePhoto    String?
  // Véhicule
  vehicleType     String?
  vehiclePlate    String?
  vehiclePhoto    String?
  // Métriques
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  acceptanceRate  Float     @default(1.0)
  warningCount    Int       @default(0)
  autoSuspended   Boolean   @default(false)
  monthlyEarnings Float     @default(0)
  earningsMonth   Int       @default(0)
  earningsYear    Int       @default(0)
  createdAt       DateTime  @default(now())
  contractSigned  Boolean   @default(false)
  plan            String    @default("BASIC")
  contract        Contract?

  orders              Order[]
  offers              DriverOffer[]
  metrics             DriverMetric[]
  planUpgradeRequests PlanUpgradeRequest[]
  commercialNotes     CommercialNote[]
  currentLocation     DriverCurrentLocation?
  locationHistory     DriverLocationHistory[]
  shipments           Shipment[]
  routes              Route[]
}

// LOT 7 (Arbitrage XXX RIZ, "logistique multi-stops MVP") : regroupe
// plusieurs Shipment déjà existants (créés normalement via
// createShipmentForOrder/createShipmentForB2BTransaction, inchangés) en une
// seule tournée pour UN livreur — PAS un moteur d'optimisation de tournées
// (VRP), juste un regroupement + séquencement manuel par l'admin. La preuve
// de livraison (OTP/QR), le paiement du livreur, les statuts Order/
// B2BTransaction restent intégralement gérés par deliveryLifecycle.js comme
// avant — une Route ne fait QUE grouper des Shipment et suivre l'ordre de
// passage, elle ne duplique aucune logique de livraison.
model Route {
  id          Int       @id @default(autoincrement())
  driverId    Int
  driver      Driver    @relation(fields: [driverId], references: [id])
  status      String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stops RouteStop[]

  @@index([driverId])
  @@index([status])
}

model RouteStop {
  id            Int       @id @default(autoincrement())
  routeId       Int
  route         Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  // Un Shipment ne peut être planifié que dans UNE tournée à la fois — la
  // livraison "hors tournée" (le cas majoritaire aujourd'hui : un livreur, une
  // course) n'est pas affectée, un Shipment sans RouteStop se comporte
  // exactement comme avant ce lot.
  shipmentId    Int       @unique
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  // Séquence de passage voulue (1, 2, 3...), modifiable par l'admin tant que
  // la tournée n'est pas terminée. Pas de contrainte d'ordre strict côté
  // livreur dans ce MVP (pas de VRP) : c'est un guide d'affichage, pas un
  // verrou qui empêcherait de traiter un arrêt hors séquence en cas d'imprévu
  // terrain (ex. client absent, on passe au suivant).
  order         Int
  // Reflète l'état du Shipment sous-jacent, jamais un état parallèle inventé :
  // COMPLETED/FAILED ne sont posés qu'après que le Shipment est réellement
  // passé DELIVERED/FAILED via le pipeline existant (OTP/QR).
  status        String    @default("PENDING") // PENDING | ARRIVED | COMPLETED | FAILED
  arrivedAt     DateTime?
  departedAt    DateTime?
  failureReason String?

  @@unique([routeId, order])
  @@index([routeId])
}

// ═══════════════════════════════════════════════════════════════════════════
// LOGISTIQUE — LOT 1 : modèle cible (arbitrage du 2026-09-05, Décision 4).
// Remplace le Map en mémoire de services/sse.js (perdu à chaque redémarrage
// serveur) — seule la DERNIÈRE position est persistée ici, jamais un
// historique de trajet (repoussé au LOT 9, ProofOfDelivery, avec une
// politique de rétention à définir avant toute collecte d'historique GPS).
// ═══════════════════════════════════════════════════════════════════════════
model DriverCurrentLocation {
  id        Int      @id @default(autoincrement())
  driverId  Int      @unique
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId   Int? // commande en cours au moment du dernier point GPS reçu
  lat       Float
  lng       Float
  accuracy  Float? // précision en mètres (navigator.geolocation), jamais collectée avant ce lot
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model DriverOffer {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId  Int
  driver    Driver   @relation(fields: [driverId], references: [id])
  status    String   @default("PENDING")
  attempt   Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Logistique — LOT 5 : historique append-only de tous les livreurs à qui une
// commande a été proposée. DriverOffer est unique par commande (une seule
// ligne, réécrite à chaque réaffectation) donc ne conserve QUE le dernier
// livreur sollicité — assignOrder() ne pouvait exclure que lui, pas
// l'historique complet, ce qui pouvait re-solliciter un livreur ayant déjà
// refusé/expiré 2 tentatives plus tôt. Ce journal corrige ça.
model DriverOfferHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  driverId  Int
  createdAt DateTime @default(now())

  @@index([orderId])
}

model DriverMetric {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  deliveries Int      @default(0)
  earnings   Float    @default(0)
  rating     Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([driverId, month, year])
}

model CarouselSlide {
  id        Int      @id @default(autoincrement())
  type      String   @default("promotion")
  title     String
  subtitle  String?
  badge     String?
  cta       String?
  ctaLink   String?
  bg        String   @default("#1B4332")
  accent    String   @default("#E8A217")
  image     String?
  active    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id                      Int      @id @default(1)
  // ── Finance ──────────────────────────────────────
  commissionRate          Float    @default(0.05)
  driverCommission        Float    @default(0.15)
  // ── Livraison ─────────────────────────────────────
  deliveryBasePrice       Float    @default(500)
  deliveryPricePerKg      Float    @default(25)
  deliveryPricePerKm      Float    @default(100)
  deliveryMaxPrice        Float    @default(8000)
  deliveryFreeAbove       Float    @default(0)
  deliveryLeadDays        Int      @default(1)
  additionalPickupFee     Float    @default(500)
  // LOT 8 (logistique) : vitesse moyenne utilisée pour l'ETA du suivi client —
  // trajet réel (route) pas vol d'oiseau, d'où une valeur prudente en zone
  // urbaine plutôt qu'une vitesse de pointe.
  deliveryAvgSpeedKmh     Float    @default(20)
  // LOT 9 : durée de rétention de l'historique GPS livreur (jours) — purge
  // opportuniste, voir DriverLocationHistory.
  gpsHistoryRetentionDays Int      @default(30)
  // ── Plans ─────────────────────────────────────────
  basicPlanPrice          Float    @default(0)
  certifiedPlanPrice      Float    @default(15000)
  certifiedMonthlyPrice   Float    @default(1500)
  driverSubPrice          Float    @default(5000)
  driverAnnualPrice       Float    @default(48000)
  // LOT PLANS (retour utilisateur) : 0 = illimité contredisait la promesse
  // "jusqu'à 50 produits actifs" déjà affichée sur la page tarifs — 50
  // devient le vrai défaut, cohérent avec ce qui est annoncé.
  basicMaxProducts        Int      @default(50)
  premiumDriverCommission Float    @default(0.20)
  // LOT PLANS (retour utilisateur) : nouvel avantage CERTIFIÉ réel, même
  // principe que premiumDriverCommission côté livreur — la boutique
  // CERTIFIÉE paie une commission plateforme réduite (elle garde une plus
  // grande part de chaque vente) au lieu du taux plat `commissionRate`
  // appliqué à tous jusqu'ici.
  certifiedCommissionRate Float    @default(0.03)
  // Restrictions fonctionnelles plan BASIC boutique
  basicCanAnalytics       Boolean  @default(true)
  shopBasicFeatures       String?
  shopCertifiedFeatures   String?
  driverBasicFeatures     String?
  driverPremiumFeatures   String?
  // ── Moteur d'assignation ──────────────────────────
  offerExpiryMin          Int      @default(15)
  minDriverRating         Float    @default(3.5)
  maxOfferAttempts        Int      @default(3)
  penaltyWarn1Rate        Float    @default(0.70)
  penaltyWarn2Rate        Float    @default(0.50)
  penaltySuspendRate      Float    @default(0.30)
  // LOT 3 (Arbitrage XXX RIZ) : durée de vie du QR dynamique de preuve de
  // livraison — jamais codée en dur (même principe que offerExpiryMin).
  qrTokenTtlMinutes       Int      @default(15)
  // ── Général ───────────────────────────────────────
  autoValidateOrders      Boolean  @default(true)
  maintenanceMode         Boolean  @default(false)
  supportEmail            String   @default("support@rizivoirien.ci")
  supportPhone            String   @default("+225 07 00 00 00")
  // ── SEO ───────────────────────────────────────────
  seoTitle                String   @default("RizIvoirien — Marketplace de riz en Côte d'Ivoire")
  seoDescription          String   @default("Achetez du riz de qualité directement auprès de coopératives ivoiriennes. Livraison rapide à Abidjan et dans toute la Côte d'Ivoire.")
  seoKeywords             String   @default("riz ivoirien, achat riz, marketplace riz, Côte d'Ivoire, livraison riz Abidjan")
  seoOgImage              String   @default("")
  seoCanonicalDomain      String   @default("https://rizivoirien.ci")
  seoGoogleId             String   @default("")
  seoFbPixelId            String   @default("")
  seoRobotsIndex          Boolean  @default(true)
  seoSitemapEnabled       Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model Subscription {
  id        Int       @id @default(autoincrement())
  shopId    Int       @unique
  shop      Shop      @relation(fields: [shopId], references: [id])
  plan      String
  status    String    @default("ACTIVE")
  startDate DateTime  @default(now())
  endDate   DateTime?
  amount    Float
}

// LOT APPROVAL (audit XXX RIZ) : mirroir structurel de PricingRule — une
// vraie table de lignes admin-définies (pas un blob PlatformSettings figé),
// pour que "règles entièrement paramétrables" veuille dire "l'admin
// ajoute/retire/désactive des lignes", pas "on édite un JSON à la main".
// `params` reste un JSON string : le shape dépend de `ruleType` (ex.
// {"min":500} pour MIN_PRICE, {"keywords":["..."]} pour BANNED_KEYWORDS) —
// volontairement schemaless pour ajouter un nouveau ruleType sans migration.
model ApprovalRule {
  id         Int      @id @default(autoincrement())
  targetType String // PRODUCT | OFFER | BOTH
  ruleType   String // MIN_PRICE | MAX_PRICE | MIN_IMAGES | MIN_DESCRIPTION_LENGTH | BANNED_KEYWORDS | CATEGORY_WHITELIST | MIN_QUANTITY
  // AUTO_REJECT : le produit/l'offre passe direct en REJECTED, avec
  // rejectionReason = label de la règle. FLAG_FOR_REVIEW : passe en
  // PENDING_REVIEW, un admin tranche à la main (aucune règle AUTO_REJECT
  // déclenchée par ailleurs) — même geste que l'approbation B2B existante.
  severity   String   @default("FLAG_FOR_REVIEW") // AUTO_REJECT | FLAG_FOR_REVIEW
  params     String // JSON, shape dépendant de ruleType
  label      String // motif lisible affiché au vendeur/admin en cas d'échec
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType])
  @@index([active])
}

model Contract {
  id          Int                 @id @default(autoincrement())
  type        String // SHOP | DRIVER
  shopId      Int?                @unique
  driverId    Int?                @unique
  shop        Shop?               @relation(fields: [shopId], references: [id])
  driver      Driver?             @relation(fields: [driverId], references: [id])
  content     String // Full HTML contract text
  status      String              @default("PENDING_SIGNATURE") // PENDING_SIGNATURE | SIGNED
  generatedAt DateTime            @default(now())
  signedAt    DateTime?
  signatures  ContractSignature[]
}

// LOT SIGNATURE (audit XXX RIZ) : jusqu'ici, "signer" ne faisait que basculer
// Contract.status/signedAt — aucune identité capturée, aucun lien immuable
// avec LE contenu exact accepté. Une régénération de contrat écrase
// Contract.content en place (admin.js CONTRACT_REGENERATE) : sans cette
// table à part, un contrat re-signé après régénération efface toute preuve
// de ce qui avait été signé la première fois. Append-only (jamais de
// update/delete) : chaque signature de l'historique reste consultable même
// après plusieurs cycles régénération/re-signature — même logique que le
// snapshot figé de B2BTransaction.ownerProducerId (jamais recalculé après coup).
model ContractSignature {
  id              Int      @id @default(autoincrement())
  contractId      Int
  contract        Contract @relation(fields: [contractId], references: [id])
  signerUserId    Int
  signerUser      User     @relation(fields: [signerUserId], references: [id])
  // Nom légal tel que retapé au moment de la signature (peut différer du
  // User.name du compte — ex. nom marital, raison sociale) : preuve
  // d'un geste de consentement actif, pas une simple case cochée.
  signedByName    String
  // Copie figée de Contract.content au moment exact de la signature —
  // jamais mise à jour si le contrat est régénéré ensuite.
  contentSnapshot String
  // SHA-256 du snapshot ci-dessus : preuve d'intégrité rapide sans
  // recomparer le texte complet.
  contentHash     String
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([contractId])
  @@index([signerUserId])
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  used      Boolean  @default(false)
  usedById  Int?
  createdAt DateTime @default(now())
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String  @default("Abidjan")
  isDefault Boolean @default(false)
  // LOT GEOLOC (retour utilisateur) : solution additionnelle — l'adresse
  // texte reste la source principale (géocodée à la volée comme avant),
  // ces coordonnées ne servent que si l'acheteur les renseigne explicitement
  // via un lien Google Maps, pour une position plus précise qu'un géocodage
  // automatique d'adresse texte. Même paire de champs que Shop.latitude/
  // longitude, pour rester cohérent avec le seul précédent déjà existant.
  latitude  Float?
  longitude Float?
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// LOT SUPPORT (retour utilisateur) : "support dédié prioritaire" était promis
// aux plans CERTIFIÉ/PREMIUM sans qu'aucun système de ticket n'existe —
// promesse retirée des pages tarifs en attendant. Ce modèle la rend réelle :
// priority est un INSTANTANÉ du standing (Shop.plan/Driver.plan) de
// l'utilisateur au moment de l'OUVERTURE du ticket, jamais recalculé après
// coup (même logique de gel que les autres snapshots du projet) — un
// changement de plan ultérieur ne doit jamais réordonner rétroactivement une
// file d'attente déjà en cours de traitement.
model SupportTicket {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("SupportTicketOwner", fields: [userId], references: [id])
  subject      String
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority     String    @default("NORMAL") // NORMAL | PRIORITY
  assignedToId Int?
  assignedTo   User?     @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?

  messages SupportTicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([userId])
}

model SupportTicketMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User          @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ── Litiges & remboursements ──────────────────────────────────────────────────
model Dispute {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  order           Order     @relation(fields: [orderId], references: [id])
  buyerId         Int
  buyer           User      @relation(fields: [buyerId], references: [id])
  reason          String
  description     String
  // OPEN | UNDER_REVIEW | RESOLVED_REFUND | RESOLVED_REJECTED | CLOSED
  status          String    @default("OPEN")
  refundAmount    Float     @default(0)
  refundProcessed Boolean   @default(false)
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ShopReview {
  id        Int      @id @default(autoincrement())
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String?
  targetId   Int?
  details    String?
  createdAt  DateTime @default(now())
}

model PlanUpgradeRequest {
  id            Int      @id @default(autoincrement())
  type          String // SHOP | DRIVER
  shopId        Int?
  shop          Shop?    @relation(fields: [shopId], references: [id])
  driverId      Int?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  fromPlan      String
  toPlan        String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  billingPeriod String   @default("monthly") // monthly | annual
  note          String?
  adminNote     String?
  amount        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([shopId])
  @@index([driverId])
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  type        String    @default("PERCENT")
  value       Float
  minOrder    Float     @default(0)
  maxUses     Int       @default(100)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model CommercialNote {
  id        Int      @id @default(autoincrement())
  shopId    Int?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  driverId  Int?
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("CommercialNoteAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([driverId])
}

// ─── Comptabilité — RBAC fin (LOT 1) ─────────────────────────────────────────
// Rôle ACCOUNTANT (libellé UI "Responsable Comptable") : rôle attribué
// explicitement par l'Admin (jamais auto-créé), avec des permissions
// individuelles ci-dessous plutôt qu'un accès comptable tout-ou-rien.
// L'ADMIN garde un accès complet implicite (voir middleware/accounting.js) —
// ce modèle ne sert qu'à moduler ce que peut faire un ACCOUNTANT.
model AccountingPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  grantedBy  Int
  grantedAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// COMPTABILITÉ — LOT 2 : modèles financiers
// Principe central (cahier de cadrage §8) : toute opération financière doit
// pouvoir être reliée à son origine métier. On utilise sourceType/sourceId
// (texte + id, même convention que B2BReport.targetType/targetId) plutôt que
// des clés étrangères dédiées par origine possible (Order, Delivery,
// Remuneration, Debt...) — sinon chaque nouvelle origine imposerait une
// migration. Pour la même raison, les champs "qui a fait/validé/exécuté
// quoi" (createdBy, validatedBy, executedBy, uploadedBy...) restent de
// simples Int indexés SANS relation Prisma formelle vers User : c'est déjà
// exactement la convention existante (AdminLog.adminId,
// OrderStatusHistory.actorId) pour des champs de traçabilité plutôt que des
// relations de domaine — la seule exception établie (CommercialNote.authorId)
// concerne un auteur central à l'objet, pas un simple horodatage d'action.
// ═══════════════════════════════════════════════════════════════════════════

model TreasuryAccount {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // CAISSE | BANQUE | MOBILE_MONEY | AUTRE
  balance   Float    @default(0) // solde en cache — ne jamais modifier hors transaction DB (LOT 5)
  currency  String   @default("XOF")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([active])
}

model FinancialTransaction {
  id                Int              @id @default(autoincrement())
  reference         String           @unique // TXN-2026-000001 (services/accountingSequence.js)
  type              String // DEBT_CREATED|RECEIVABLE_CREATED|PAYMENT_EXECUTED|ENCAISSEMENT|DECAISSEMENT|COMMISSION_APPLIED|EXPENSE_RECORDED|TRANSFER|ADJUSTMENT
  direction         String // IN | OUT — sens du mouvement pour la trésorerie de la plateforme
  amount            Float
  currency          String           @default("XOF")
  status            String           @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  sourceType        String? // ORDER|DELIVERY|REMUNERATION|PAYMENT_ORDER|PAYMENT|DEBT|RECEIVABLE|EXPENSE|COMMISSION|SUBSCRIPTION|MANUAL
  sourceId          Int?
  accountId         Int?
  account           TreasuryAccount? @relation(fields: [accountId], references: [id])
  actorUserId       Int? // utilisateur à l'origine du mouvement (ex : client qui règle)
  beneficiaryUserId Int? // utilisateur qui reçoit (ex : livreur payé)
  beneficiaryName   String? // repli texte libre si le bénéficiaire n'a pas de compte plateforme
  transferGroupId   String? // relie les deux écritures d'un même virement interne
  description       String?
  createdBy         Int
  validatedBy       Int?
  validatedAt       DateTime?
  reconciled        Boolean          @default(false) // rapprochement bancaire (LOT 7, §28)
  reconciledAt      DateTime?
  reconciledBy      Int?
  date              DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([type])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([accountId])
  @@index([beneficiaryUserId])
  @@index([date])
  @@index([reconciled])
}

model Debt {
  id                Int       @id @default(autoincrement())
  beneficiaryUserId Int?
  beneficiaryName   String?
  sourceType        String // ORDER|DELIVERY|REMUNERATION|SUBSCRIPTION_REFUND|MANUAL
  sourceId          Int?
  initialAmount     Float
  paidAmount        Float     @default(0)
  currency          String    @default("XOF")
  status            String    @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  dueDate           DateTime?
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([beneficiaryUserId])
  @@index([status])
  @@index([sourceType, sourceId])
}

model Receivable {
  id             Int       @id @default(autoincrement())
  debtorUserId   Int?
  debtorName     String?
  sourceType     String // SUBSCRIPTION|PLAN_UPGRADE|B2B_TRANSACTION|MANUAL
  sourceId       Int?
  amount         Float
  receivedAmount Float     @default(0)
  currency       String    @default("XOF")
  status         String    @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  dueDate        DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([debtorUserId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// Règle configurable (taux courant). Ne JAMAIS relire cette table pour
// recalculer une Remuneration/transaction passée — le taux réellement
// appliqué est toujours snapshotté sur l'objet qui l'a consommé
// (Remuneration.appliedCommissionRate) pour ne jamais changer rétroactivement
// un montant déjà calculé (§24).
model CommissionRule {
  id          Int       @id @default(autoincrement())
  type        String // PLATFORM_SALE | DELIVERY | SUBSCRIPTION | B2B | OTHER
  rate        Float?
  fixedAmount Float?
  category    String?
  actorType   String? // SELLER | DRIVER | COOPERATIVE | ALL
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdBy   Int
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([status])
}

// Ce que la personne doit recevoir — distinct de PaymentOrder (l'instruction
// de payer) et de Payment (le mouvement réel), §11.
model Remuneration {
  id                    Int       @id @default(autoincrement())
  reference             String    @unique // REM-2026-000001
  beneficiaryUserId     Int
  beneficiaryType       String // DRIVER | SELLER | COOPERATIVE | EMPLOYEE
  periodStart           DateTime
  periodEnd             DateTime
  sourceType            String // DELIVERIES | SALES | MANUAL
  grossAmount           Float
  bonusAmount           Float     @default(0)
  penaltyAmount         Float     @default(0)
  advanceAmount         Float     @default(0)
  netAmount             Float
  appliedCommissionRate Float?
  calculationDetail     String    @default("[]") // JSON : détail ligne par ligne du calcul (§13)
  status                String    @default("DRAFT")
  // DRAFT|CALCULATED|PENDING_VALIDATION|VALIDATED|PAYMENT_PENDING|PAYMENT_PROCESSING|PAID|REJECTED|CANCELLED|PAYMENT_FAILED
  documentType          String? // PAYSLIP | REMUNERATION_STATEMENT | SETTLEMENT_STATEMENT (§16)
  createdBy             Int
  calculatedAt          DateTime?
  validatedBy           Int?
  validatedAt           DateTime?
  rejectedReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  paymentOrder PaymentOrder?

  @@index([beneficiaryUserId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// L'instruction autorisant le paiement — pas encore le mouvement d'argent.
model PaymentOrder {
  id                Int           @id @default(autoincrement())
  reference         String        @unique // ORD-2026-000001
  beneficiaryUserId Int?
  beneficiaryName   String?
  amount            Float
  currency          String        @default("XOF")
  reason            String
  sourceType        String // REMUNERATION | DEBT | EXPENSE | MANUAL
  sourceId          Int?
  remunerationId    Int?          @unique
  remuneration      Remuneration? @relation(fields: [remunerationId], references: [id])
  accountId         Int? // compte de trésorerie à débiter
  paymentMethod     String? // CASH | BANK_TRANSFER | MOBILE_MONEY | OTHER
  status            String        @default("PENDING_CONTROL")
  // PENDING_CONTROL|ON_HOLD|PENDING_PAYMENT|PROCESSING|PAID|REJECTED|FAILED|CANCELLED
  holdReason        String?
  rejectedReason    String?
  createdBy         Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments Payment[]

  @@index([status])
  @@index([beneficiaryUserId])
}

// Le mouvement d'argent réellement effectué (§20). Plusieurs Payment
// possibles par PaymentOrder (un échec n'annule pas l'ordre, une nouvelle
// tentative crée un nouveau Payment).
model Payment {
  id                Int          @id @default(autoincrement())
  reference         String       @unique // PAY-2026-000001
  paymentOrderId    Int
  paymentOrder      PaymentOrder @relation(fields: [paymentOrderId], references: [id])
  amount            Float
  currency          String       @default("XOF")
  beneficiaryUserId Int?
  beneficiaryName   String?
  accountId         Int?
  method            String // CASH | BANK_TRANSFER | MOBILE_MONEY | OTHER
  status            String       @default("PENDING") // PENDING | PROCESSING | PAID | FAILED | CANCELLED | REFUNDED
  executedBy        Int?
  executedAt        DateTime?
  failureReason     String?
  documentUrl       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([paymentOrderId])
}

model Expense {
  id          Int       @id @default(autoincrement())
  reference   String    @unique // EXP-2026-000001
  category    String
  amount      Float
  currency    String    @default("XOF")
  date        DateTime  @default(now())
  supplier    String?
  accountId   Int?
  description String?
  documentUrl String?
  status      String    @default("DRAFT") // DRAFT | PENDING_VALIDATION | VALIDATED | PAID | REJECTED
  createdBy   Int
  validatedBy Int?
  validatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([category])
}

// Justificatif attaché à une opération comptable (§26) — réutilise le
// stockage existant (Cloudinary/disque, middleware/upload.js) : ce modèle ne
// garde que la référence, jamais le fichier lui-même.
model AccountingDocument {
  id         Int      @id @default(autoincrement())
  targetType String // DEBT | RECEIVABLE | PAYMENT_ORDER | PAYMENT | EXPENSE | REMUNERATION
  targetId   Int
  docType    String // INVOICE | RECEIPT | CONTRACT | PROOF_OF_PAYMENT | PAYSLIP | SETTLEMENT_STATEMENT | OTHER
  url        String
  uploadedBy Int
  uploadedAt DateTime @default(now())

  @@index([targetType, targetId])
}

// Compteur pour les références uniques générées serveur (§32) — jamais côté
// frontend. Une ligne par préfixe+année (ex : "PAY-2026"), incrémentée via
// upsert atomique (services/accountingSequence.js).
model AccountingSequence {
  key     String @id
  counter Int    @default(0)
}
