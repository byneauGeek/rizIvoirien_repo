generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PRODUCTION : changer "sqlite" → "postgresql" + mettre DATABASE_URL dans les secrets du serveur
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("BUYER")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerified    Boolean   @default(false)
  emailVerifyToken String?
  resetToken       String?
  resetTokenExpiry DateTime?

  shop            Shop?
  driver          Driver?
  orders          Order[]          @relation("BuyerOrders")
  addresses       Address[]
  reviews         Review[]
  shopReviews     ShopReview[]
  wishlist        Wishlist[]
  notifications   Notification[]
  disputes        Dispute[]
  commercialNotes CommercialNote[] @relation("CommercialNoteAuthor")

  // ── Module B2B (filière riz) ──────────────────────────────────────────────
  producer    Producer?
  cooperative Cooperative?
  trader      Trader?
  processor   Processor?
  exporter    Exporter?

  contactsSent            ContactRequest[] @relation("ContactFrom")
  contactsReceived        ContactRequest[] @relation("ContactTo")
  b2bTransactionsAsBuyer  B2BTransaction[] @relation("B2BTransactionBuyer")
  b2bTransactionsAsSeller B2BTransaction[] @relation("B2BTransactionSeller")
  b2bReportsFiled         B2BReport[]

  // ── Comptabilité ─────────────────────────────────────────────────────────
  accountingPermissions AccountingPermission[]
}

// ─── B2B : profils ──────────────────────────────────────────────────────────

model Producer {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  region       String
  department   String?
  commune      String?
  locality     String?
  farmType     String?
  surfaceHa    Float?
  capacityKg   Float?
  photo        String?
  description  String?
  verification String   @default("UNVERIFIED") // UNVERIFIED|PENDING|VERIFIED|SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cooperativeMemberships CooperativeMember[]
  offers                 RiceOffer[]

  @@index([region])
  @@index([verification])
}

model Cooperative {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String
  responsable  String
  region       String
  zone         String?
  description  String?
  verification String   @default("UNVERIFIED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members CooperativeMember[]
  offers  RiceOffer[]

  @@index([region])
  @@index([verification])
}

model CooperativeMember {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  producerId    Int
  producer      Producer    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())

  @@unique([cooperativeId, producerId])
}

model Trader {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  companyName  String
  activity     String?
  zones        String?
  verification String   @default("UNVERIFIED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

model Processor {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  companyName  String
  zones        String?
  verification String   @default("UNVERIFIED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

model Exporter {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  companyName  String
  capacityKg   Float?
  zones        String?
  verification String   @default("UNVERIFIED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests PurchaseRequest[]

  @@index([verification])
}

// ─── B2B : offres & demandes ────────────────────────────────────────────────

model RiceOffer {
  id            Int          @id @default(autoincrement())
  producerId    Int?
  producer      Producer?    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  cooperativeId Int?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  product       String // "Riz paddy" | "Riz blanchi"
  variety       String?
  quantity      Float
  unit          String // kg | tonne | sac
  region        String
  availableFrom DateTime?
  quality       String?
  price         Float?
  photos        String       @default("[]")
  status        String       @default("DRAFT") // DRAFT|AVAILABLE|RESERVED|SOLD|EXPIRED|DISABLED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  contactRequests ContactRequest[]

  @@index([status])
  @@index([region])
  @@index([product])
  @@index([producerId])
  @@index([cooperativeId])
}

model PurchaseRequest {
  id           Int        @id @default(autoincrement())
  traderId     Int?
  trader       Trader?    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  processorId  Int?
  processor    Processor? @relation(fields: [processorId], references: [id], onDelete: Cascade)
  exporterId   Int?
  exporter     Exporter?  @relation(fields: [exporterId], references: [id], onDelete: Cascade)
  product      String
  quantity     Float
  unit         String
  region       String
  period       String?
  requirements String?
  status       String     @default("ACTIVE") // DRAFT|ACTIVE|FULFILLED|EXPIRED|CANCELLED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contactRequests ContactRequest[]

  @@index([status])
  @@index([region])
  @@index([product])
  @@index([traderId])
  @@index([processorId])
  @@index([exporterId])
}

// ─── B2B : mise en relation & transaction déclarée ──────────────────────────
// Le contact est le SEUL mécanisme qui révèle les coordonnées entre deux
// utilisateurs B2B (voir b2bContact.js) — jamais exposées directement sur une
// offre/demande publique.
model ContactRequest {
  id         Int              @id @default(autoincrement())
  fromUserId Int
  fromUser   User             @relation("ContactFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User             @relation("ContactTo", fields: [toUserId], references: [id])
  offerId    Int?
  offer      RiceOffer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  requestId  Int?
  request    PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  message    String?
  status     String           @default("PENDING") // PENDING|ACCEPTED|REJECTED
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  transaction B2BTransaction?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model B2BTransaction {
  id           Int             @id @default(autoincrement())
  contactId    Int?            @unique
  contact      ContactRequest? @relation(fields: [contactId], references: [id])
  buyerUserId  Int
  buyer        User            @relation("B2BTransactionBuyer", fields: [buyerUserId], references: [id])
  sellerUserId Int
  seller       User            @relation("B2BTransactionSeller", fields: [sellerUserId], references: [id])
  product      String
  quantity     Float
  unit         String
  region       String
  amount       Float?
  status       String          @default("DECLARED") // DECLARED|CANCELLED
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([buyerUserId])
  @@index([sellerUserId])
  @@index([status])
}

model B2BReport {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String // PROFILE | OFFER | REQUEST
  targetId   Int
  reason     String
  status     String   @default("PENDING") // PENDING|REVIEWING|RESOLVED|REJECTED
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// Listes de référence gérables par l'admin (cahier de cadrage §16 : "gestion
// des catégories, régions, produits et unités"). Volontairement une simple
// table valeur/type plutôt que 3 modèles séparés — aucune autre table ne
// pointe vers elle par clé étrangère (region/product/unit restent des champs
// texte libres sur RiceOffer/PurchaseRequest), elle ne fait qu'alimenter les
// suggestions affichées côté frontend.
model B2BReferenceItem {
  id     Int     @id @default(autoincrement())
  type   String // REGION | PRODUCT | UNIT
  value  String
  active Boolean @default(true)

  @@unique([type, value])
  @@index([type, active])
}

model Shop {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id])
  // Identité
  name               String
  slug               String    @unique
  businessName       String?
  rccm               String?
  description        String?
  speciality         String?
  since              String?
  // Contact
  phone              String?
  email              String?
  // Localisation
  location           String?
  latitude           Float?
  longitude          Float?
  deliveryZones      String?
  // Médias
  coverImage         String?
  avatar             String?
  // Opérationnel
  minOrder           Float     @default(0)
  preparationTime    Int       @default(30)
  openingHours       String?
  paused             Boolean   @default(false)
  pauseNote          String?
  // Notifications
  notifyEmail        Boolean   @default(true)
  notifyLowStock     Boolean   @default(true)
  // Contact social
  whatsapp           String?
  facebook           String?
  instagram          String?
  // Vente
  paymentMethods     String    @default("[]")
  tags               String?
  // Annonce temporaire
  announcement       String?
  announcementActive Boolean   @default(false)
  // Statut & plan
  status             String    @default("PENDING")
  active             Boolean   @default(false)
  plan               String    @default("BASIC")
  certified          Boolean   @default(false)
  // Métriques
  rating             Float     @default(5.0)
  reviewCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  contractSigned     Boolean   @default(false)
  contract           Contract?

  products            Product[]
  orders              Order[]
  subscription        Subscription?
  shopReviews         ShopReview[]
  planUpgradeRequests PlanUpgradeRequest[]
  commercialNotes     CommercialNote[]
}

model Product {
  id              Int      @id @default(autoincrement())
  shopId          Int
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  slug            String   @unique
  description     String?
  category        String
  price           Float
  unit            String   @default("5kg")
  pricePerKg      Float    @default(0)
  stock           Int      @default(0)
  images          String   @default("[]")
  badge           String?
  origin          String?
  harvest         String?
  // RETAIL = détail uniquement | WHOLESALE = gros uniquement | BOTH = gros & détail
  saleType        String   @default("BOTH")
  wholesalePrice  Float?
  minWholesaleQty Int?
  rating          Float    @default(5.0)
  reviewCount     Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
  wishlist   Wishlist[]
  history    ProductHistory[]

  @@index([shopId])
  @@index([active])
  @@index([saleType])
}

model ProductHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId   Int
  actorName String
  changes   String // JSON : { field: { from, to, label } }[]
  createdAt DateTime @default(now())
}

model Order {
  id             Int      @id @default(autoincrement())
  buyerId        Int
  buyer          User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  shopId         Int
  shop           Shop     @relation(fields: [shopId], references: [id])
  driverId       Int?
  driver         Driver?  @relation(fields: [driverId], references: [id])
  status         String   @default("PENDING")
  total          Float
  deliveryFee    Float    @default(0)
  discount       Float    @default(0)
  promoCode      String?
  address        String
  note           String?
  groupId        String?
  idempotencyKey String?
  paymentMethod  String   @default("CASH_ON_DELIVERY")
  driverRated    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  driverOffer   DriverOffer?
  dispute       Dispute?

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId])
  @@index([shopId])
  @@index([driverId])
  @@index([status])
  @@index([groupId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  name      String
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  actorId   Int?
  createdAt DateTime @default(now())
}

model Driver {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  inviteCode      String    @unique
  // Statut
  status          String    @default("PENDING")
  online          Boolean   @default(false)
  available       Boolean   @default(true)
  // Identité
  avatar          String?
  idNumber        String?
  idPhoto         String?
  // Permis
  licenseNumber   String?
  licenseExpiry   String?
  licensePhoto    String?
  // Véhicule
  vehicleType     String?
  vehiclePlate    String?
  vehiclePhoto    String?
  // Métriques
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  acceptanceRate  Float     @default(1.0)
  warningCount    Int       @default(0)
  autoSuspended   Boolean   @default(false)
  monthlyEarnings Float     @default(0)
  earningsMonth   Int       @default(0)
  earningsYear    Int       @default(0)
  createdAt       DateTime  @default(now())
  contractSigned  Boolean   @default(false)
  plan            String    @default("BASIC")
  contract        Contract?

  orders              Order[]
  offers              DriverOffer[]
  metrics             DriverMetric[]
  planUpgradeRequests PlanUpgradeRequest[]
  commercialNotes     CommercialNote[]
}

model DriverOffer {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId  Int
  driver    Driver   @relation(fields: [driverId], references: [id])
  status    String   @default("PENDING")
  attempt   Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DriverMetric {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  deliveries Int      @default(0)
  earnings   Float    @default(0)
  rating     Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([driverId, month, year])
}

model CarouselSlide {
  id        Int      @id @default(autoincrement())
  type      String   @default("promotion")
  title     String
  subtitle  String?
  badge     String?
  cta       String?
  ctaLink   String?
  bg        String   @default("#1B4332")
  accent    String   @default("#E8A217")
  image     String?
  active    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id                      Int      @id @default(1)
  // ── Finance ──────────────────────────────────────
  commissionRate          Float    @default(0.05)
  driverCommission        Float    @default(0.15)
  // ── Livraison ─────────────────────────────────────
  deliveryBasePrice       Float    @default(500)
  deliveryPricePerKg      Float    @default(25)
  deliveryPricePerKm      Float    @default(100)
  deliveryMaxPrice        Float    @default(8000)
  deliveryFreeAbove       Float    @default(0)
  deliveryLeadDays        Int      @default(1)
  additionalPickupFee     Float    @default(500)
  // ── Plans ─────────────────────────────────────────
  basicPlanPrice          Float    @default(0)
  certifiedPlanPrice      Float    @default(15000)
  certifiedMonthlyPrice   Float    @default(1500)
  driverSubPrice          Float    @default(5000)
  driverAnnualPrice       Float    @default(48000)
  basicMaxProducts        Int      @default(0)
  premiumDriverCommission Float    @default(0.20)
  // Restrictions fonctionnelles plan BASIC boutique
  basicCanAnalytics       Boolean  @default(true)
  shopBasicFeatures       String?
  shopCertifiedFeatures   String?
  driverBasicFeatures     String?
  driverPremiumFeatures   String?
  // ── Moteur d'assignation ──────────────────────────
  offerExpiryMin          Int      @default(15)
  minDriverRating         Float    @default(3.5)
  maxOfferAttempts        Int      @default(3)
  penaltyWarn1Rate        Float    @default(0.70)
  penaltyWarn2Rate        Float    @default(0.50)
  penaltySuspendRate      Float    @default(0.30)
  // ── Général ───────────────────────────────────────
  autoValidateOrders      Boolean  @default(true)
  maintenanceMode         Boolean  @default(false)
  supportEmail            String   @default("support@rizivoirien.ci")
  supportPhone            String   @default("+225 07 00 00 00")
  // ── SEO ───────────────────────────────────────────
  seoTitle                String   @default("RizIvoirien — Marketplace de riz en Côte d'Ivoire")
  seoDescription          String   @default("Achetez du riz de qualité directement auprès de coopératives ivoiriennes. Livraison rapide à Abidjan et dans toute la Côte d'Ivoire.")
  seoKeywords             String   @default("riz ivoirien, achat riz, marketplace riz, Côte d'Ivoire, livraison riz Abidjan")
  seoOgImage              String   @default("")
  seoCanonicalDomain      String   @default("https://rizivoirien.ci")
  seoGoogleId             String   @default("")
  seoFbPixelId            String   @default("")
  seoRobotsIndex          Boolean  @default(true)
  seoSitemapEnabled       Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model Subscription {
  id        Int       @id @default(autoincrement())
  shopId    Int       @unique
  shop      Shop      @relation(fields: [shopId], references: [id])
  plan      String
  status    String    @default("ACTIVE")
  startDate DateTime  @default(now())
  endDate   DateTime?
  amount    Float
}

model Contract {
  id          Int       @id @default(autoincrement())
  type        String // SHOP | DRIVER
  shopId      Int?      @unique
  driverId    Int?      @unique
  shop        Shop?     @relation(fields: [shopId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])
  content     String // Full HTML contract text
  status      String    @default("PENDING_SIGNATURE") // PENDING_SIGNATURE | SIGNED
  generatedAt DateTime  @default(now())
  signedAt    DateTime?
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  used      Boolean  @default(false)
  usedById  Int?
  createdAt DateTime @default(now())
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String  @default("Abidjan")
  isDefault Boolean @default(false)
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// ── Litiges & remboursements ──────────────────────────────────────────────────
model Dispute {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  order           Order     @relation(fields: [orderId], references: [id])
  buyerId         Int
  buyer           User      @relation(fields: [buyerId], references: [id])
  reason          String
  description     String
  // OPEN | UNDER_REVIEW | RESOLVED_REFUND | RESOLVED_REJECTED | CLOSED
  status          String    @default("OPEN")
  refundAmount    Float     @default(0)
  refundProcessed Boolean   @default(false)
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ShopReview {
  id        Int      @id @default(autoincrement())
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String?
  targetId   Int?
  details    String?
  createdAt  DateTime @default(now())
}

model PlanUpgradeRequest {
  id            Int      @id @default(autoincrement())
  type          String // SHOP | DRIVER
  shopId        Int?
  shop          Shop?    @relation(fields: [shopId], references: [id])
  driverId      Int?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  fromPlan      String
  toPlan        String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  billingPeriod String   @default("monthly") // monthly | annual
  note          String?
  adminNote     String?
  amount        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([shopId])
  @@index([driverId])
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  type        String    @default("PERCENT")
  value       Float
  minOrder    Float     @default(0)
  maxUses     Int       @default(100)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model CommercialNote {
  id        Int      @id @default(autoincrement())
  shopId    Int?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  driverId  Int?
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("CommercialNoteAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([driverId])
}

// ─── Comptabilité — RBAC fin (LOT 1) ─────────────────────────────────────────
// Rôle ACCOUNTANT (libellé UI "Responsable Comptable") : rôle attribué
// explicitement par l'Admin (jamais auto-créé), avec des permissions
// individuelles ci-dessous plutôt qu'un accès comptable tout-ou-rien.
// L'ADMIN garde un accès complet implicite (voir middleware/accounting.js) —
// ce modèle ne sert qu'à moduler ce que peut faire un ACCOUNTANT.
model AccountingPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  grantedBy  Int
  grantedAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// COMPTABILITÉ — LOT 2 : modèles financiers
// Principe central (cahier de cadrage §8) : toute opération financière doit
// pouvoir être reliée à son origine métier. On utilise sourceType/sourceId
// (texte + id, même convention que B2BReport.targetType/targetId) plutôt que
// des clés étrangères dédiées par origine possible (Order, Delivery,
// Remuneration, Debt...) — sinon chaque nouvelle origine imposerait une
// migration. Pour la même raison, les champs "qui a fait/validé/exécuté
// quoi" (createdBy, validatedBy, executedBy, uploadedBy...) restent de
// simples Int indexés SANS relation Prisma formelle vers User : c'est déjà
// exactement la convention existante (AdminLog.adminId,
// OrderStatusHistory.actorId) pour des champs de traçabilité plutôt que des
// relations de domaine — la seule exception établie (CommercialNote.authorId)
// concerne un auteur central à l'objet, pas un simple horodatage d'action.
// ═══════════════════════════════════════════════════════════════════════════

model TreasuryAccount {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // CAISSE | BANQUE | MOBILE_MONEY | AUTRE
  balance   Float    @default(0) // solde en cache — ne jamais modifier hors transaction DB (LOT 5)
  currency  String   @default("XOF")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([active])
}

model FinancialTransaction {
  id                Int              @id @default(autoincrement())
  reference         String           @unique // TXN-2026-000001 (services/accountingSequence.js)
  type              String // DEBT_CREATED|RECEIVABLE_CREATED|PAYMENT_EXECUTED|ENCAISSEMENT|DECAISSEMENT|COMMISSION_APPLIED|EXPENSE_RECORDED|TRANSFER|ADJUSTMENT
  direction         String // IN | OUT — sens du mouvement pour la trésorerie de la plateforme
  amount            Float
  currency          String           @default("XOF")
  status            String           @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  sourceType        String? // ORDER|DELIVERY|REMUNERATION|PAYMENT_ORDER|PAYMENT|DEBT|RECEIVABLE|EXPENSE|COMMISSION|SUBSCRIPTION|MANUAL
  sourceId          Int?
  accountId         Int?
  account           TreasuryAccount? @relation(fields: [accountId], references: [id])
  actorUserId       Int? // utilisateur à l'origine du mouvement (ex : client qui règle)
  beneficiaryUserId Int? // utilisateur qui reçoit (ex : livreur payé)
  beneficiaryName   String? // repli texte libre si le bénéficiaire n'a pas de compte plateforme
  transferGroupId   String? // relie les deux écritures d'un même virement interne
  description       String?
  createdBy         Int
  validatedBy       Int?
  validatedAt       DateTime?
  date              DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([type])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([accountId])
  @@index([beneficiaryUserId])
  @@index([date])
}

model Debt {
  id                Int       @id @default(autoincrement())
  beneficiaryUserId Int?
  beneficiaryName   String?
  sourceType        String // ORDER|DELIVERY|REMUNERATION|SUBSCRIPTION_REFUND|MANUAL
  sourceId          Int?
  initialAmount     Float
  paidAmount        Float     @default(0)
  currency          String    @default("XOF")
  status            String    @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  dueDate           DateTime?
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([beneficiaryUserId])
  @@index([status])
  @@index([sourceType, sourceId])
}

model Receivable {
  id             Int       @id @default(autoincrement())
  debtorUserId   Int?
  debtorName     String?
  sourceType     String // SUBSCRIPTION|PLAN_UPGRADE|B2B_TRANSACTION|MANUAL
  sourceId       Int?
  amount         Float
  receivedAmount Float     @default(0)
  currency       String    @default("XOF")
  status         String    @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  dueDate        DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([debtorUserId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// Règle configurable (taux courant). Ne JAMAIS relire cette table pour
// recalculer une Remuneration/transaction passée — le taux réellement
// appliqué est toujours snapshotté sur l'objet qui l'a consommé
// (Remuneration.appliedCommissionRate) pour ne jamais changer rétroactivement
// un montant déjà calculé (§24).
model CommissionRule {
  id          Int       @id @default(autoincrement())
  type        String // PLATFORM_SALE | DELIVERY | SUBSCRIPTION | B2B | OTHER
  rate        Float?
  fixedAmount Float?
  category    String?
  actorType   String? // SELLER | DRIVER | COOPERATIVE | ALL
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdBy   Int
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([status])
}

// Ce que la personne doit recevoir — distinct de PaymentOrder (l'instruction
// de payer) et de Payment (le mouvement réel), §11.
model Remuneration {
  id                    Int       @id @default(autoincrement())
  reference             String    @unique // REM-2026-000001
  beneficiaryUserId     Int
  beneficiaryType       String // DRIVER | SELLER | COOPERATIVE | EMPLOYEE
  periodStart           DateTime
  periodEnd             DateTime
  sourceType            String // DELIVERIES | SALES | MANUAL
  grossAmount           Float
  bonusAmount           Float     @default(0)
  penaltyAmount         Float     @default(0)
  advanceAmount         Float     @default(0)
  netAmount             Float
  appliedCommissionRate Float?
  calculationDetail     String    @default("[]") // JSON : détail ligne par ligne du calcul (§13)
  status                String    @default("DRAFT")
  // DRAFT|CALCULATED|PENDING_VALIDATION|VALIDATED|PAYMENT_PENDING|PAYMENT_PROCESSING|PAID|REJECTED|CANCELLED|PAYMENT_FAILED
  documentType          String? // PAYSLIP | REMUNERATION_STATEMENT | SETTLEMENT_STATEMENT (§16)
  createdBy             Int
  calculatedAt          DateTime?
  validatedBy           Int?
  validatedAt           DateTime?
  rejectedReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  paymentOrder PaymentOrder?

  @@index([beneficiaryUserId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// L'instruction autorisant le paiement — pas encore le mouvement d'argent.
model PaymentOrder {
  id                Int           @id @default(autoincrement())
  reference         String        @unique // ORD-2026-000001
  beneficiaryUserId Int?
  beneficiaryName   String?
  amount            Float
  currency          String        @default("XOF")
  reason            String
  sourceType        String // REMUNERATION | DEBT | EXPENSE | MANUAL
  sourceId          Int?
  remunerationId    Int?          @unique
  remuneration      Remuneration? @relation(fields: [remunerationId], references: [id])
  accountId         Int? // compte de trésorerie à débiter
  paymentMethod     String? // CASH | BANK_TRANSFER | MOBILE_MONEY | OTHER
  status            String        @default("PENDING_CONTROL")
  // PENDING_CONTROL|ON_HOLD|PENDING_PAYMENT|PROCESSING|PAID|REJECTED|FAILED|CANCELLED
  holdReason        String?
  rejectedReason    String?
  createdBy         Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments Payment[]

  @@index([status])
  @@index([beneficiaryUserId])
}

// Le mouvement d'argent réellement effectué (§20). Plusieurs Payment
// possibles par PaymentOrder (un échec n'annule pas l'ordre, une nouvelle
// tentative crée un nouveau Payment).
model Payment {
  id                Int          @id @default(autoincrement())
  reference         String       @unique // PAY-2026-000001
  paymentOrderId    Int
  paymentOrder      PaymentOrder @relation(fields: [paymentOrderId], references: [id])
  amount            Float
  currency          String       @default("XOF")
  beneficiaryUserId Int?
  beneficiaryName   String?
  accountId         Int?
  method            String // CASH | BANK_TRANSFER | MOBILE_MONEY | OTHER
  status            String       @default("PENDING") // PENDING | PROCESSING | PAID | FAILED | CANCELLED | REFUNDED
  executedBy        Int?
  executedAt        DateTime?
  failureReason     String?
  documentUrl       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([paymentOrderId])
}

model Expense {
  id          Int       @id @default(autoincrement())
  reference   String    @unique // EXP-2026-000001
  category    String
  amount      Float
  currency    String    @default("XOF")
  date        DateTime  @default(now())
  supplier    String?
  accountId   Int?
  description String?
  documentUrl String?
  status      String    @default("DRAFT") // DRAFT | PENDING_VALIDATION | VALIDATED | PAID | REJECTED
  createdBy   Int
  validatedBy Int?
  validatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([category])
}

// Justificatif attaché à une opération comptable (§26) — réutilise le
// stockage existant (Cloudinary/disque, middleware/upload.js) : ce modèle ne
// garde que la référence, jamais le fichier lui-même.
model AccountingDocument {
  id         Int      @id @default(autoincrement())
  targetType String // DEBT | RECEIVABLE | PAYMENT_ORDER | PAYMENT | EXPENSE | REMUNERATION
  targetId   Int
  docType    String // INVOICE | RECEIPT | CONTRACT | PROOF_OF_PAYMENT | PAYSLIP | SETTLEMENT_STATEMENT | OTHER
  url        String
  uploadedBy Int
  uploadedAt DateTime @default(now())

  @@index([targetType, targetId])
}

// Compteur pour les références uniques générées serveur (§32) — jamais côté
// frontend. Une ligne par préfixe+année (ex : "PAY-2026"), incrémentée via
// upsert atomique (services/accountingSequence.js).
model AccountingSequence {
  key     String @id
  counter Int    @default(0)
}
